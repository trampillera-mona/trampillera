# Copy this file to .env and replace every secret before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_PORT=3000
COOKIE_SECURE=false
TRUST_PROXY=false
TRAMPILLERA_DOMAIN=example.com

# Optional server-side AI integration. Qwen is the default; provider keys stay server-side.
AI_PROVIDER=qwen
QWEN_API_KEY=
QWEN_API_URL=https://your-workspace-id.eu-central-1.maas.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen4-max

# Optional alternative provider.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-4.1-mini
