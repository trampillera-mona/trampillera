# Copy this file to .env and replace every secret before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_PORT=3000
COOKIE_SECURE=false
TRUST_PROXY=false
TRAMPILLERA_DOMAIN=example.com

# Optional server-side AI integration. Never put provider keys in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
