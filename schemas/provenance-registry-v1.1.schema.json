{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trampillera.com/schemas/provenance-registry-v1.1.schema.json",
  "title": "TRAMPILLERA Provenance Registry",
  "type": "object",
  "required": ["schema", "standard", "brand", "product", "release", "issued", "registry_notice", "assets"],
  "properties": {
    "schema": { "const": "trampillera.provenance.registry.v1.1" },
    "standard": { "const": "TMP-BPS-STD-001" },
    "brand": { "const": "TRAMPILLERA" },
    "product": { "type": "string", "minLength": 1 },
    "release": { "type": "string", "minLength": 1 },
    "issued": { "type": "string", "format": "date" },
    "registry_notice": { "type": "string", "minLength": 20 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "path", "type", "version", "origin_type", "attribution", "rights_status", "issued"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{5,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^/worlds-play/.+" },
          "type": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "origin_type": { "enum": ["first-party-original", "commissioned", "partner-provided", "licensed-third-party", "user-generated", "derivative"] },
          "attribution": { "type": "string", "minLength": 1 },
          "rights_status": { "type": "string", "minLength": 1 },
          "issued": { "type": "string", "format": "date" },
          "source_asset_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
